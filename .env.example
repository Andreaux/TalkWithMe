# Copy to .env and edit. docker compose reads it automatically.
# Application settings (LLM/TTS/STT endpoints, personas, rooms) are NOT
# configured here — they live in the UI and in data/settings.yaml.

# Where the browser reaches the app. 127.0.0.1 means "this machine
# only"; put a reverse proxy in front of it, or set 0.0.0.0 to expose it
# on the LAN — TalkWithMe has no login, so only do that on a network you
# trust.
TALKWITHME_BIND_ADDR=127.0.0.1
TALKWITHME_PORT=8000

# Host directory holding all persistent state. Must be writable by
# PUID:PGID below:  mkdir -p data && sudo chown -R 1000:1000 data
TALKWITHME_DATA_DIR=./data
PUID=1000
PGID=1000

# Optional: API key for a remote LLM. Takes precedence over the
# data/llm_api_key file. Leave blank for a local llama.cpp server.
TALKWITHME_LLM_API_KEY=

# debug | info | warning | error | critical
TALKWITHME_LOG_LEVEL=info

TZ=UTC
